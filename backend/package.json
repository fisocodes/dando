{
	"dependencies": {
		"@nestjs/common": "^12.1.3",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.3",
		"@nestjs/platform-express": "^12.1.3",
		"@nestjs/typeorm": "^12.0.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^1.1.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.8",
		"@nestjs/schematics": "^12.0.7",
		"@types/node": "^26.6.5",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"main": "dist/src/main",
	"scripts": {
		"build": "nest build",
		"start:dev": "nest start --watch",
		"start:prod": "node .",
